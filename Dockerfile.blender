# Lean pod for the 3D boardroom: Blender 5.2.1 (same as the laptop), Hunyuan3D-2 image to 3D (weights on the network volume), rembg, Rhubarb.
# transformers stays below 5: version 5 renamed the DINOv2 layers and Hunyuan's weights stop loading.
# Kept separate from the main image so pods pull only what this job needs.
FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/hf U2NET_HOME=/workspace/u2net HY3DGEN_MODELS=/workspace/hy3dgen \
    TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0;12.0"

# System tools plus the libraries headless Blender needs
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg curl wget git ca-certificates xz-utils unzip \
      libxi6 libxxf86vm1 libxfixes3 libxrender1 libxkbcommon0 libsm6 libice6 libx11-6 libxext6 \
      libgl1 libegl1 libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

# Blender 5.2.1, so .blend files open the same here and on the laptop
ARG BLENDER=5.2.1
RUN curl -fsSL https://download.blender.org/release/Blender5.2/blender-${BLENDER}-linux-x64.tar.xz | tar -xJ -C /opt \
    && ln -s /opt/blender-${BLENDER}-linux-x64/blender /usr/local/bin/blender \
    && blender -b --factory-startup --python-expr "import bpy; print('blender ok', bpy.app.version_string)"

# Rhubarb Lip Sync
RUN curl -fsSL -o /tmp/rh.zip https://github.com/DanielSWolf/rhubarb-lip-sync/releases/download/v1.13.0/Rhubarb-Lip-Sync-1.13.0-Linux.zip \
    && unzip -q /tmp/rh.zip -d /opt && rm /tmp/rh.zip \
    && ln -s /opt/Rhubarb-Lip-Sync-1.13.0-Linux/rhubarb /usr/local/bin/rhubarb && rhubarb --version

# Hunyuan3D-2: code, the two CUDA extensions for texturing, and rembg
RUN nvcc --version \
    && pip freeze | grep -iE '^(torch|torchvision|torchaudio)==' > /opt/torch-pins.txt \
    && git clone --depth 1 https://github.com/Tencent-Hunyuan/Hunyuan3D-2 /opt/Hunyuan3D-2 \
    && cd /opt/Hunyuan3D-2 \
    && pip install -c /opt/torch-pins.txt -r requirements.txt \
    && pip install -c /opt/torch-pins.txt -e . \
    && pip install -c /opt/torch-pins.txt rembg onnxruntime huggingface_hub hf_transfer pybind11 "transformers==4.57.3" "diffusers==0.35.2" \
    && cd hy3dgen/texgen/custom_rasterizer && pip install --no-build-isolation . \
    && cd ../differentiable_renderer && pip install --no-build-isolation . \
    && python -c "import torch, hy3dgen.shapegen, custom_rasterizer; print('hy3d ok', torch.__version__)"

# Weights live on the RunPod network volume, not in the image, so pods boot fast. fetch_weights.py fills it once.
# The build downloads them to /tmp, proves the shape model loads, then deletes them in the same step so the image stays small.
ENV HF_HUB_ENABLE_HF_TRANSFER=1
COPY fetch_weights.py /opt/fetch_weights.py
RUN HY3DGEN_MODELS=/tmp/hy U2NET_HOME=/tmp/u2 python /opt/fetch_weights.py     && HY3DGEN_MODELS=/tmp/hy python -c "from hy3dgen.shapegen import Hunyuan3DDiTFlowMatchingPipeline as P; P.from_pretrained('tencent/Hunyuan3D-2', subfolder='hunyuan3d-dit-v2-0', variant='fp16', use_safetensors=True, device='cpu'); print('shape model loads ok')"     && rm -rf /tmp/hy /tmp/u2 /root/.cache

# CMD stays the base image's /start.sh, so SSH and Jupyter keep working.
